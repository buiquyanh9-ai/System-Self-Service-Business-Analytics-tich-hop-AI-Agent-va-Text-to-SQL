# Đặt các biến môi trường này trước khi chạy (PowerShell: $env:ANTHROPIC_API_KEY="sk-ant-...")
# Có ANTHROPIC_API_KEY -> agent dùng Claude function calling; để trống -> bộ hiểu tiếng Việt offline
ANTHROPIC_API_KEY=
# Hoặc dùng OpenRouter (API tương thích OpenAI): có OPENROUTER_API_KEY -> agent gọi model qua OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-6-luna
# auto | claude | openrouter | offline   (auto: Claude nếu có key Anthropic, kế đến OpenRouter, cuối cùng offline)
# File .env ở gốc dự án được nạp tự động khi khởi động; .env đã nằm trong .gitignore.
LLM_MODE=auto
LLM_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
LLM_EFFORT=medium
# Doanh nghiệp phục vụ: để trống = doanh nghiệp mẫu ABC ở gốc dự án; đặt tên thư mục trong workspaces/ để chạy doanh nghiệp khác
# (vd WORKSPACE=giaovan_xyz). Tạo workspace mới từ một kho DuckDB: python -m app.onboard <tên> --db <file.duckdb>
WORKSPACE=
# Khóa ký JWT phiên đăng nhập
APP_SECRET=change-me
# Tùy chọn: chấp nhận access token Supabase Auth (vai trò lấy từ app_metadata.role)
SUPABASE_JWT_SECRET=
# Triển khai công khai: mật khẩu thật cho tài khoản (thay mật khẩu mẫu trong policies.yml; tài khoản đó không hiện trên
# màn hình đăng nhập). Tên biến = PASSWORD_ + tên tài khoản viết hoa. DEMO_LOGIN=0 để ẩn mọi nút tài khoản dùng thử.
PASSWORD_ADMIN=
DEMO_LOGIN=
